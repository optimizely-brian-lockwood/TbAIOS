# TbAI OS — User Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and NEVER committed — it belongs to you,
# not to the repo. Every team member sets their own.
#
#   cp .env.example .env
#   (then edit .env with your actual values)
# ─────────────────────────────────────────────────────────────

# Your corporate email address — used by /corp-data and /morning-briefing
# to authenticate the Claude CLI subprocess with your company's Anthropic plan.
CORPORATE_EMAIL=you@yourcompany.com
